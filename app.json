{
  "expo": {
    "name": "Scripture First",
    "slug": "scripture-first",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "scripturefirst",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jamiedoe.scripturefirst"
    },
    "plugins": ["expo-router", "./src/modules/screen-time/plugin/withFamilyControls"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.jamiedoe.scripturefirst"
    }
  }
}
