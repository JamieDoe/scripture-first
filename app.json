{
  "expo": {
    "name": "Scripture First",
    "slug": "scripture-first",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "scripturefirst",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jamiedoe.scripturefirst",
      "appleTeamId": "CUVWYY83Y8"
    },
    "plugins": [
      "expo-router",
      "./src/modules/screen-time/plugin/withFamilyControls",
      ["@bacons/apple-targets", { "teamId": "CUVWYY83Y8" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.jamiedoe.scripturefirst"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "shield-config",
                  "bundleIdentifier": "com.jamiedoe.scripturefirst.ShieldConfig",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": ["group.com.jamiedoe.scripturefirst"]
                  }
                },
                {
                  "targetName": "shield-action",
                  "bundleIdentifier": "com.jamiedoe.scripturefirst.ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": ["group.com.jamiedoe.scripturefirst"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
