{
  "name": "@scripture-first/screen-time",
  "version": "0.1.0",
  "description": "Screen Time APIs for Scripture First",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "expo-module": {
    "platforms": [
      "apple"
    ]
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "lint:swift": "swiftlint lint",
    "lint:swift:fix": "swiftlint --fix",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "screen-time",
    "ExpoScreenTime"
  ],
  "repository": "https://github.com/JamieDoe/scripture-first",
  "bugs": {
    "url": "https://github.com/JamieDoe/scripture-first/issues"
  },
  "author": "JamieDoe <jamieoliverdoe@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/JamieDoe/scripture-first#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
